#!/bin/sh
# First-boot defaults for the VPN tether distribution.
# Idempotent: safe to re-run.

. /lib/functions.sh

# ---------------------------------------------------------------------------
# Identity / services
# ---------------------------------------------------------------------------
uci -q set system.@system[0].hostname='vpn-tether'
uci -q set system.ntp.enabled='1'
uci -q commit system
/etc/init.d/sysntpd enable 2>/dev/null
/etc/init.d/dropbear enable 2>/dev/null
/etc/init.d/uhttpd enable 2>/dev/null

# ---------------------------------------------------------------------------
# USB gadget: NCM (works on Linux and modern Windows)
# ---------------------------------------------------------------------------
uci -q set usbgadget.usb.enabled='1'
uci -q set usbgadget.ncm.enabled='1'
uci -q set usbgadget.rndis.enabled='0'
uci -q set usbgadget.ecm.enabled='0'
uci -q commit usbgadget

# ---------------------------------------------------------------------------
# WiFi: STA uplink skeleton + disabled AP fallback
# ---------------------------------------------------------------------------
uci -q set wireless.radio0.disabled='0'
uci -q set wireless.wan_sta=wifi-iface
uci -q set wireless.wan_sta.device='radio0'
uci -q set wireless.wan_sta.mode='sta'
uci -q set wireless.wan_sta.network='wwan'
uci -q set wireless.wan_sta.encryption='psk2'
uci -q set wireless.wan_sta.disabled='0'
uci -q set wireless.default_radio0=wifi-iface
uci -q set wireless.default_radio0.device='radio0'
uci -q set wireless.default_radio0.mode='ap'
uci -q set wireless.default_radio0.network='lan'
uci -q set wireless.default_radio0.ssid='OpenWrt'
uci -q set wireless.default_radio0.encryption='none'
uci -q set wireless.default_radio0.disabled='1'
uci -q commit wireless

# ---------------------------------------------------------------------------
# Network: WiFi uplink (wwan) + WireGuard client skeleton (filled by the UI)
# ---------------------------------------------------------------------------
uci -q set network.wwan=interface
uci -q set network.wwan.proto='dhcp'

uci -q set network.wg0=interface
uci -q set network.wg0.proto='wireguard'
uci -q set network.wg0.auto='0'
uci -q set network.wg0.addresses='10.55.185.5/24'

uci -q set network.peer=wireguard_wg0
uci -q set network.peer.allowed_ips='0.0.0.0/0'
uci -q set network.peer.route_allowed_ips='1'
uci -q set network.peer.persistent_keepalive='25'
uci -q commit network

# ---------------------------------------------------------------------------
# DNS: avoid NAT64 AAAA for the WG endpoint, forward LAN DNS via the tunnel
# ---------------------------------------------------------------------------
uci -q set dhcp.@dnsmasq[0].filter_aaaa='1'
uci -q commit dhcp

# ---------------------------------------------------------------------------
# Firewall: WAN = wifi uplink + modem, VPN zone for wg0, lan -> vpn only
# ---------------------------------------------------------------------------
WAN_ZONE=""
wzt() {
	local cfg="$1" name
	config_get name "$cfg" name
	[ "$name" = "wan" ] && WAN_ZONE="$cfg"
}
config_load firewall
config_foreach wzt zone
if [ -n "$WAN_ZONE" ]; then
	uci -q del_list "firewall.$WAN_ZONE.network=wwan"
	uci -q add_list "firewall.$WAN_ZONE.network=wwan"
	uci -q del_list "firewall.$WAN_ZONE.network=modem"
	uci -q add_list "firewall.$WAN_ZONE.network=modem"
fi

# VPN zone
uci -q delete firewall.vpn
uci set firewall.vpn=zone
uci set firewall.vpn.name='vpn'
uci set firewall.vpn.network='wg0'
uci set firewall.vpn.input='ACCEPT'
uci set firewall.vpn.output='ACCEPT'
uci set firewall.vpn.forward='ACCEPT'
uci set firewall.vpn.masq='1'
uci set firewall.vpn.mtu_fix='1'

# Kill switch: only lan -> vpn
uci -q delete firewall.lan_to_vpn
uci set firewall.lan_to_vpn=forwarding
uci set firewall.lan_to_vpn.src='lan'
uci set firewall.lan_to_vpn.dest='vpn'

# Remove the stock lan -> wan forwarding
rm_lan_wan() {
	local cfg="$1" src dest
	config_get src "$cfg" src
	config_get dest "$cfg" dest
	[ "$src" = "lan" ] && [ "$dest" = "wan" ] && uci -q delete "firewall.$cfg"
}
config_foreach rm_lan_wan forwarding

uci -q commit firewall

exit 0
