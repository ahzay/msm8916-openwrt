#!/bin/sh
# On every WiFi-uplink connect: resync the clock, then start WireGuard.
#
# The dongle has no usable RTC, so the clock can be stale/1970 on boot. WG's
# replay protection makes the server silently drop handshakes with an old
# timestamp, and once wg0 is up its default route takes over the dongle's own
# traffic (this kernel has no policy routing), so NTP could never sync.
#
# Therefore, whenever the uplink ("wwan") comes up:
#   1. release wg0 so the dongle's own traffic uses the WiFi uplink,
#   2. make sure a direct default route exists (metric 200 fallback),
#   3. force an NTP sync,
#   4. then start wg0 (metric 0 default takes over for the PC).
[ "$ACTION" = "ifup" ] || [ "$ACTION" = "ifdown" ] || exit 0
[ "$INTERFACE" = "wwan" ] || exit 0

if [ "$ACTION" = "ifup" ]; then
	(
		ifdown wg0 2>/dev/null
		sleep 2

		gw=$(ubus call network.interface.wwan status 2>/dev/null | jsonfilter -e '@.route[0].nexthop' 2>/dev/null)
		[ -n "$gw" ] && ip route replace default via "$gw" dev phy0-sta0 metric 200 2>/dev/null

		/usr/sbin/ntpd -n -q \
			-p 0.openwrt.pool.ntp.org -p 1.openwrt.pool.ntp.org \
			-p 2.openwrt.pool.ntp.org -p 3.openwrt.pool.ntp.org \
			>/dev/null 2>&1

		ifup wg0
	) &
else
	ifdown wg0
	ip route del default metric 200 2>/dev/null
fi
